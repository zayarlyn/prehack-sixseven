generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  microsoftId      String    @unique
  email            String    @unique
  fullName         String
  avatarUrl        String?
  year             Int?
  programLevel     String?
  faculty          String?
  major            String?
  bio              String?
  onboarded        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items            Item[]
  conversationsAsBuyer   Conversation[] @relation("buyerConversations")
  conversationsAsSeller  Conversation[] @relation("sellerConversations")
  transactionsAsBuyer    Transaction[] @relation("buyerTransactions")
  transactionsAsSeller   Transaction[] @relation("sellerTransactions")

  @@map("users")
}

model S3Object {
  id               String    @id @default(cuid())
  key              String    @unique
  publicUrl        String
  contentType      String
  sizeBytes        Int?
  context          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  itemImages       ItemImage[]

  @@map("s3_objects")
}

model Item {
  id               String    @id @default(cuid())
  sellerId         String
  title            String
  description      String
  price            Float
  category         String
  condition        String
  pickupLocation   String?
  openToOffers     Boolean   @default(false)
  status           String    @default("active")
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  soldAt           DateTime?
  deletedAt        DateTime?

  seller           User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemImages       ItemImage[]
  conversations    Conversation[]
  transactions     Transaction[]

  @@map("items")
}

model ItemImage {
  id               String    @id @default(cuid())
  itemId           String?
  s3ObjectId       String
  createdAt        DateTime  @default(now())

  item             Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  s3Object         S3Object  @relation(fields: [s3ObjectId], references: [id], onDelete: Cascade)

  @@map("item_images")
}

model Conversation {
  id               String    @id @default(cuid())
  firebaseId       String    @unique
  itemId           String
  buyerId          String
  sellerId         String
  createdAt        DateTime  @default(now())
  lastMessageAt    DateTime  @updatedAt

  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer            User      @relation("buyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User      @relation("sellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@map("conversations")
}

model Transaction {
  id               String    @id @default(cuid())
  itemId           String
  sellerId         String
  buyerId          String
  conversationId   String?
  finalPrice       Float
  note             String?
  createdAt        DateTime  @default(now())

  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller           User      @relation("sellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer            User      @relation("buyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("transactions")
}
